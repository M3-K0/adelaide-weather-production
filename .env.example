# Adelaide Weather Forecasting System - Environment Configuration
# Copy this file to .env and set your actual values.
# For production, copy to .env.production and update all values.
# NEVER commit .env.production or any file with real secrets to git.

# REQUIRED: API Authentication Token (NEVER commit real tokens to git)
API_TOKEN=your-secure-api-token-here

# Optional: API base URL (defaults to http://localhost:8000 in development)
API_BASE_URL=http://localhost:8000

# Optional: Environment (development, staging, production)
ENVIRONMENT=development

# Optional: CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Optional: Logging level
LOG_LEVEL=INFO

# Optional: Rate limiting
RATE_LIMIT_PER_MINUTE=60

# Performance Settings
PERFORMANCE_CACHE_TTL=300

# Database (if using external database)
# DATABASE_URL=postgresql://user:password@host:port/database

# Monitoring
# GRAFANA_PASSWORD=your-grafana-password-here

# Frontend
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1

# SSL/TLS (for HTTPS setup)
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem

# Backup and Storage
# BACKUP_STORAGE_PATH=/data/backups
# LOG_STORAGE_PATH=/data/logs